{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "debugassist.api"
      ],
      "port": 8400
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/dashboard",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/site",
        "dev"
      ],
      "port": 3300
    }
  ]
}
