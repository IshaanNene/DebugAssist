+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const flags = vi.hoisted(() => ({ v2: false }));
+vi.mock("../src/flags", () => ({
+  FLAGS: { notifRouterV2: "notif_router_v2" },
+  flag: () => flags.v2,
+}));
+
+import { routeDeepLink } from "../src/notifications/router";
+import { hydrate, resetSessionForTests } from "../src/store/session";
+
+describe("router v2 hydration bug reproduction", () => {
+  beforeEach(() => {
+    flags.v2 = true;
+    resetSessionForTests();
+    vi.useFakeTimers();
+  });
+  afterEach(() => vi.useRealTimers());
+
+  it("a tap right after launch waits for session hydration before accessing riderId", async () => {
+    const navigate = vi.fn();
+    
+    // Start hydration with realistic delay (350ms as per the bug report)
+    void hydrate({ delayMs: 350 });
+    
+    // Immediately call routeDeepLink (simulating push notification tap right after launch)
+    // This should NOT crash - it should wait for hydration to complete
+    const routed = routeDeepLink("/ride/abc", navigate, "push");
+    
+    // At this point, hydration hasn't completed (only 100ms passed, need 350ms)
+    await vi.advanceTimersByTimeAsync(100);
+    
+    // navigate should NOT have been called yet because session isn't hydrated
+    expect(navigate).not.toHaveBeenCalled();
+    
+    // Now advance past hydration delay
+    await vi.advanceTimersByTimeAsync(300);
+    
+    // The route should now complete successfully
+    await expect(routed).resolves.toBeUndefined();
+    
+    // navigate should have been called with the correct link and riderId in state
+    expect(navigate).toHaveBeenCalledTimes(1);
+    expect(navigate.mock.calls[0]![0]).toBe("/ride/abc");
+    expect(navigate.mock.calls[0]![1]).toEqual(
+      expect.objectContaining({
+        state: expect.objectContaining({
+          riderId: expect.any(String),
+          prefill: null,
+        }),
+      })
+    );
+  });
+});
