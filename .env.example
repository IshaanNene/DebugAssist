# Copy to .env. Any integration whose keys are missing runs in mock mode.
# Force a mode per integration with DA_MODE_<LLM|CLEF|GITHUB|JIRA|SLACK>=live|mock (LLM also: replay).

# LLM reasoning — OpenAI-compatible providers (ADR 0007). GroqCloud is used when its key is set.
GROQ_CLOUD_API=
OPEN_ROUTER_API_KEY=
# LLM_PROVIDER=groq            # groq | openrouter
# LLM_MODEL=openai/gpt-oss-120b  # default per provider: groq → gpt-oss-120b, openrouter → nemotron-3-ultra free
# LLM_MAX_REQUEST_TOKENS=7000   # per-request token budget (default 7000 on Groq's free plan; 0 = none)

# Clef decision models — Cloudflare Workers AI (API token with Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# GitHub — fine-grained PAT scoped to the two demo target repos (contents + pull requests: write)
GITHUB_TOKEN=

# Jira Cloud — all three required for live mode
JIRA_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=

# Slack bot (optional; mock inbox otherwise)
SLACK_BOT_TOKEN=
