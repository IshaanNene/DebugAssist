# Copy to .env. Any integration whose keys are missing runs in mock mode.
# Force a mode per integration with DA_MODE_<LLM|CLEF|GITHUB|JIRA|CHAT>=live|mock (LLM also: replay).

# LLM reasoning — OpenAI-compatible providers (ADR 0007). GroqCloud is used when its key is set.
GROQ_CLOUD_API=
OPEN_ROUTER_API_KEY=
# LLM_PROVIDER=groq            # groq | openrouter
# LLM_MODEL=openai/gpt-oss-120b  # default per provider: groq → gpt-oss-120b, openrouter → nemotron-3-ultra free
# LLM_MAX_REQUEST_TOKENS=5000   # per-request input budget (default 5000 on Groq's free plan; 0 = none)
# LLM_MAX_OUTPUT_TOKENS=2500    # output cap (default 2500 on Groq, 16000 elsewhere)

# Clef decision models — Cloudflare Workers AI (API token with Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# GitHub — fine-grained PAT scoped to the two demo target repos (contents + pull requests: write)
GITHUB_TOKEN=

# Jira Cloud — all three required for live mode
JIRA_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=

# Team chat (optional; local mock inbox otherwise): a Discord channel webhook URL (free).
# Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Agent tracing: phoenix (default) | langfuse | both | 0. Each backend is used only when it answers.
# DA_TRACING=both
# Langfuse: `make langfuse` self-hosts it on :3200; these are that local instance's project keys
# (local-only dev credentials, set in infra/docker-compose.yml). For Langfuse Cloud use your project's keys.
# LANGFUSE_HOST=http://localhost:3200
# LANGFUSE_PUBLIC_KEY=pk-lf-debugassist-local
# LANGFUSE_SECRET_KEY=sk-lf-debugassist-local
