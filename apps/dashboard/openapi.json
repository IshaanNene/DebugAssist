{
  "components": {
    "schemas": {
      "AppMetrics": {
        "additionalProperties": true,
        "description": "Running totals of the App's poll; keys appear as events happen (`app_cli.count`).",
        "properties": {
          "errors": {
            "default": 0,
            "title": "Errors",
            "type": "integer"
          },
          "not_onboarded": {
            "default": 0,
            "title": "Not Onboarded",
            "type": "integer"
          },
          "rate_limited": {
            "default": 0,
            "title": "Rate Limited",
            "type": "integer"
          },
          "retries": {
            "default": 0,
            "title": "Retries",
            "type": "integer"
          },
          "runs_done": {
            "default": 0,
            "title": "Runs Done",
            "type": "integer"
          },
          "runs_failed": {
            "default": 0,
            "title": "Runs Failed",
            "type": "integer"
          },
          "runs_given_up": {
            "default": 0,
            "title": "Runs Given Up",
            "type": "integer"
          },
          "runs_started": {
            "default": 0,
            "title": "Runs Started",
            "type": "integer"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "title": "AppMetrics",
        "type": "object"
      },
      "AskIn": {
        "properties": {
          "correction": {
            "default": false,
            "title": "Correction",
            "type": "boolean"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "required": [
          "message"
        ],
        "title": "AskIn",
        "type": "object"
      },
      "DiffFixIn": {
        "properties": {
          "instruction": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Instruction",
            "type": "string"
          }
        },
        "required": [
          "instruction"
        ],
        "title": "DiffFixIn",
        "type": "object"
      },
      "EnqueueIn": {
        "properties": {
          "agent_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Type"
          },
          "issue": {
            "pattern": "^(VIT|BD)-\\d+$",
            "title": "Issue",
            "type": "string"
          },
          "llm": {
            "default": "live",
            "enum": [
              "live",
              "mock"
            ],
            "title": "Llm",
            "type": "string"
          }
        },
        "required": [
          "issue"
        ],
        "title": "EnqueueIn",
        "type": "object"
      },
      "FeedbackIn": {
        "properties": {
          "comment": {
            "default": "",
            "maxLength": 2000,
            "title": "Comment",
            "type": "string"
          },
          "reaction": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Reaction",
            "type": "string"
          },
          "target": {
            "default": "rca",
            "maxLength": 64,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "reaction"
        ],
        "title": "FeedbackIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "HealthDeps": {
        "properties": {
          "app_queue": {
            "title": "App Queue",
            "type": "string"
          },
          "ledger": {
            "title": "Ledger",
            "type": "string"
          },
          "runs_dir": {
            "title": "Runs Dir",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "runs_dir",
          "app_queue",
          "ledger"
        ],
        "title": "HealthDeps",
        "type": "object"
      },
      "RunSummary": {
        "description": "One row of the run list (`data.summary`).",
        "properties": {
          "app": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "cost_usd": {
            "default": 0.0,
            "title": "Cost Usd",
            "type": "number"
          },
          "customer_impacting": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Impacting"
          },
          "issue_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Id"
          },
          "issue_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Ref"
          },
          "jira": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jira"
          },
          "llm_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Mode"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "oncall": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oncall"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          },
          "pr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr"
          },
          "priority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "seconds": {
            "default": 0.0,
            "title": "Seconds",
            "type": "number"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "validated": {
            "default": false,
            "title": "Validated",
            "type": "boolean"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "watch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Watch"
          },
          "worth_agent_run": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worth Agent Run"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DebugAssist API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/app/metrics": {
      "get": {
        "description": "What the GitHub App's poll has done: runs started, done, failed, retried, given up, rate limits, errors.",
        "operationId": "app_metrics_api_app_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppMetrics"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "App Metrics"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/health/deps": {
      "get": {
        "description": "Each dependency on its own (ROADMAP-100 056): a run needs the runs dir, the App its queue, decisions the\nledger; \"ok\" only when all of them are.",
        "operationId": "health_deps_api_health_deps_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDeps"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Deps"
      }
    },
    "/api/inbox": {
      "get": {
        "operationId": "get_inbox_api_inbox_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get Inbox Api Inbox Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Inbox"
      }
    },
    "/api/issues": {
      "get": {
        "description": "Vitals issues and BugDrop reports, each with its latest run (triage, status, outcome).",
        "operationId": "list_issues_api_issues_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Issues Api Issues Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Issues"
      }
    },
    "/api/marketplace": {
      "get": {
        "operationId": "marketplace_api_marketplace_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Marketplace Api Marketplace Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Marketplace"
      }
    },
    "/api/metrics": {
      "get": {
        "operationId": "metrics_api_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Metrics Api Metrics Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/api/proposals": {
      "get": {
        "description": "Skill updates proposed by the feedback loop (local marketplace PRs awaiting a human).",
        "operationId": "proposals_api_proposals_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Proposals Api Proposals Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Proposals"
      }
    },
    "/api/runs": {
      "get": {
        "description": "Newest first; pass the last run id of a page as `before` for the next one (at most 500 per page).",
        "operationId": "list_runs_api_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "issue",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Issue"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  },
                  "title": "Response List Runs Api Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Runs"
      },
      "post": {
        "description": "Queue an issue for a worker (Redis + Arq); it runs in its agent type's runtime container.",
        "operationId": "enqueue_run_api_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnqueueIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Enqueue Run Api Runs Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Enqueue Run"
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "operationId": "get_run_api_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
