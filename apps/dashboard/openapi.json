    "/api/runs/{run_id}/chat": {
      "get": {
        "operationId": "chat_sessions_api_runs__run_id__chat_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Chat Sessions Api Runs  Run Id  Chat Get",
