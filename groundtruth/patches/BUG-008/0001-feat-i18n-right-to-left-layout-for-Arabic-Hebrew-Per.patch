From: Priya Nair <priya.nair@miniride.dev>
Date: Sun, 4 Oct 2026 12:57:16 +0530
Subject: [PATCH] feat(i18n): right-to-left layout for Arabic, Hebrew, Persian
 and Urdu

Set the document language and direction from the device locale at
startup, and use logical CSS properties for the push toast so it lays
out correctly in RTL.
---
 src/i18n.ts       | 20 ++++++++++++++++++++
 src/main.tsx      |  2 ++
 src/styles.css    |  2 +-
 test/i18n.test.ts | 19 +++++++++++++++++++
 4 files changed, 42 insertions(+), 1 deletion(-)
 create mode 100644 src/i18n.ts
 create mode 100644 test/i18n.test.ts

diff --git a/src/i18n.ts b/src/i18n.ts
new file mode 100644
index 0000000..7da1a7d
--- /dev/null
+++ b/src/i18n.ts
@@ -0,0 +1,20 @@
+// Document language and text direction from the device locale.
+const RTL_LANGUAGES = new Set(["ar", "he", "fa", "ur"]);
+
+export interface LocaleDirection {
+  lang: string;
+  dir: "ltr" | "rtl";
+}
+
+/** Normalise a BCP 47 tag ("ar-eg" → "ar-EG") and pick the text direction. */
+export function localeDirection(locale: string): LocaleDirection {
+  const [language, region] = locale.split("-");
+  const lang = `${language!.toLowerCase()}-${region!.toUpperCase()}`;
+  return { lang, dir: RTL_LANGUAGES.has(language!.toLowerCase()) ? "rtl" : "ltr" };
+}
+
+export function applyLocaleDirection(locale: string = navigator.language, root: HTMLElement = document.documentElement) {
+  const { lang, dir } = localeDirection(locale);
+  root.lang = lang;
+  root.dir = dir;
+}
