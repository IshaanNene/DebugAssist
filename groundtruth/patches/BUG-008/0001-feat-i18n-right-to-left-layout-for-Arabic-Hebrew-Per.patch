diff --git a/test/i18n.test.ts b/test/i18n.test.ts
new file mode 100644
index 0000000..0ba7066
--- /dev/null
+++ b/test/i18n.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from "vitest";
+import { applyLocaleDirection, localeDirection } from "../src/i18n";
+
+describe("locale direction", () => {
+  it.each([
+    ["en-US", "en-US", "ltr"],
+    ["ar-EG", "ar-EG", "rtl"],
+    ["he-il", "he-IL", "rtl"],
+    ["ja-JP", "ja-JP", "ltr"],
+  ])("%s → %s %s", (locale, lang, dir) => {
+    expect(localeDirection(locale)).toEqual({ lang, dir });
+  });
+
+  it("sets lang and dir on the root element", () => {
+    const el = document.createElement("html");
+    applyLocaleDirection("ar-SA", el);
+    expect([el.lang, el.dir]).toEqual(["ar-SA", "rtl"]);
+  });
+});
