diff --git a/src/styles.css b/src/styles.css
index 6badce6..f001517 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -31,6 +31,6 @@ select { font: inherit; padding: 10px; border-radius: 10px; border: 1px solid va
 .notifications { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
 .notifications button, .toast { all: unset; display: flex; flex-direction: column; gap: 2px; width: 100%; padding: 12px; border-radius: 12px; border: 1px solid var(--line); cursor: pointer; box-sizing: border-box; }
