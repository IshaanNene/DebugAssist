From 8bb551a4459c3088b558153da40885292d084a4e Mon Sep 17 00:00:00 2001
From: Lucas Meyer <lucas.meyer@miniride.dev>
Date: Tue, 6 Oct 2026 21:59:41 +0530
Subject: [PATCH] refactor(gateway): keep ride notification copy in one
 exported table

Product wants to edit the push copy without reading resolver code. Move the per-status titles and bodies into STATUS_NOTIFICATIONS and export notifyStatus so it can be unit-tested.
---
 gateway/src/schema.ts | 23 ++++++++++-------------
 1 file changed, 10 insertions(+), 13 deletions(-)

diff --git a/gateway/src/schema.ts b/gateway/src/schema.ts
index 7bcd06b..3177c68 100644
--- a/gateway/src/schema.ts
+++ b/gateway/src/schema.ts
@@ -56,19 +56,16 @@ const fareOut = (q: FareQuote) => ({
 
 const rideOut = (r: RideOut) => ({ ...r, distanceKm: r.distance_km, createdAt: r.created_at });
 
-function notifyStatus(ctx: Ctx, rideId: string, status: string) {
-  const text: Record<string, [string, string]> = {
-    driver_assigned: ["Driver assigned", "Your driver is on the way."],
-    arriving: ["Your driver is arriving", "Head to the pickup point."],
-    completed: ["Trip complete", "Thanks for riding with MiniRide."],
-  };
-  const t = text[status];
-  if (!t) return;
-  ctx.notifications.push(
-    ctx.sessionId,
-    { kind: `ride.${status}`, title: t[0], body: t[1], deepLink: `/ride/${rideId}` },
-    `${rideId}:${status}`,
-  );
+/** Push-notification copy per ride status (statuses without copy are not announced). */
+export const STATUS_NOTIFICATIONS: Record<string, { title: string; body: string }> = {
+  driver_assigned: { title: "Driver assigned", body: "Your driver is on the way." },
+  arriving: { title: "Your driver is arriving", body: "Head to the pickup point." },
+  completed: { title: "Trip complete", body: "Thanks for riding with MiniRide." },
+};
+
+export function notifyStatus(ctx: Ctx, rideId: string, status: string) {
+  const { title, body } = STATUS_NOTIFICATIONS[status] as { title: string; body: string };
+  ctx.notifications.push(ctx.sessionId, { kind: `ride.${status}`, title, body, deepLink: `/ride/${rideId}` }, `${rideId}:${status}`);
 }
 
 export const schema = createSchema<Ctx>({
-- 
