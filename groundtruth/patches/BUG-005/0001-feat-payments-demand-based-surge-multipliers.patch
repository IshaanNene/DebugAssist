 	if errors.Is(err, fares.ErrUnknownCity) {
diff --git a/payments/surge.go b/payments/surge.go
new file mode 100644
index 0000000..84634e8
--- /dev/null
+++ b/payments/surge.go
@@ -0,0 +1,39 @@
+package main
+
+import (
+	"math"
+	"sync"
+	"time"
+)
+
+type surgeEntry struct {
+	multiplier float64
+	at         time.Time
+}
+
+// surgeCache memoizes per-city surge multipliers for a short TTL: computing them reads demand
+// signals that only change every few minutes.
+type surgeCache struct {
+	mu      sync.Mutex
+	ttl     time.Duration
+	entries map[string]surgeEntry
+}
+
+func (c *surgeCache) get(city string, now time.Time, compute func(string, time.Time) float64) float64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if e, ok := c.entries[city]; ok && now.Sub(e.at) < c.ttl {
+		return e.multiplier
+	}
+	m := compute(city, now)
+	c.entries[city] = surgeEntry{multiplier: m, at: now}
+	return m
+}
+
+// demandMultiplier models evening demand: 1.0 off-peak up to 1.6 around 18:00 local time.
+func demandMultiplier(city string, now time.Time) float64 {
+	offsets := map[string]int{"sf": -7, "nyc": -4, "blr": 5, "tokyo": 9}
+	hour := float64((now.UTC().Hour() + offsets[city] + 24) % 24)
+	peak := math.Exp(-math.Pow(hour-18, 2) / 8)
+	return math.Round((1+0.6*peak)*10) / 10
+}
diff --git a/payments/surge_test.go b/payments/surge_test.go
new file mode 100644
index 0000000..0ecd179
--- /dev/null
+++ b/payments/surge_test.go
@@ -0,0 +1,32 @@
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+func TestSurgeCacheReusesValueWithinTTL(t *testing.T) {
+	c := &surgeCache{ttl: time.Minute, entries: map[string]surgeEntry{}}
+	calls := 0
+	compute := func(string, time.Time) float64 { calls++; return 1.3 }
+	now := time.Now()
+	if c.get("sf", now, compute) != 1.3 || c.get("sf", now.Add(30*time.Second), compute) != 1.3 {
+		t.Fatal("unexpected multiplier")
+	}
+	if calls != 1 {
+		t.Fatalf("expected 1 compute, got %d", calls)
+	}
+	c.get("sf", now.Add(2*time.Minute), compute)
+	if calls != 2 {
+		t.Fatalf("expected recompute after TTL, got %d", calls)
+	}
+}
+
+func TestDemandMultiplierRange(t *testing.T) {
+	for h := 0; h < 24; h++ {
+		m := demandMultiplier("sf", time.Date(2026, 10, 1, h, 0, 0, 0, time.UTC))
+		if m < 1 || m > 1.6 {
+			t.Fatalf("hour %d: %v out of range", h, m)
+		}
+	}
+}
