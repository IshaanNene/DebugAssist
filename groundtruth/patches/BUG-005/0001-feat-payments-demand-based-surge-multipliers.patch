 payments/surge.go      | 39 +++++++++++++++++++++++++++++++++++++++
 payments/surge_test.go | 32 ++++++++++++++++++++++++++++++++
 3 files changed, 74 insertions(+), 2 deletions(-)
 create mode 100644 payments/surge.go
 create mode 100644 payments/surge_test.go

