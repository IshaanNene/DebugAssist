From fe7ba75271dff4672602441d787fd5187d5ea2de Mon Sep 17 00:00:00 2001
From: Omar Haddad <omar.haddad@miniride.dev>
Date: Mon, 19 Oct 2026 11:58:40 +0530
Subject: [PATCH] feat(dispatch): drivers can go offline

The driver app can now take a driver off shift (PUT /drivers/{id}/status); offline drivers are never matched. Existing databases get the new drivers.online column at startup, since create_all only creates missing tables.
---
 dispatch/src/dispatch/app.py      | 19 ++++++++++++++++++-
 dispatch/src/dispatch/db.py       | 24 +++++++++++++++++++++++-
 dispatch/src/dispatch/matching.py |  7 ++++++-
 dispatch/tests/test_dispatch.py   |  9 +++++++++
 4 files changed, 56 insertions(+), 3 deletions(-)

diff --git a/dispatch/src/dispatch/app.py b/dispatch/src/dispatch/app.py
index b9791db..faed2ef 100644
--- a/dispatch/src/dispatch/app.py
+++ b/dispatch/src/dispatch/app.py
@@ -19,7 +19,7 @@ from sqlalchemy.exc import IntegrityError
 from sqlalchemy.orm import Session
 
 from dispatch import telemetry, vitals_sdk
-from dispatch.db import Base, Driver, Ride, make_engine, make_sessionmaker, seed
+from dispatch.db import Base, Driver, Ride, make_engine, make_sessionmaker, migrate, seed
 from dispatch.flags import Flags
 from dispatch.geo import PLACES, Point, haversine_km
 from dispatch.matching import NoDriversAvailable, eta_seconds, nearest_available_driver, ride_status
@@ -40,6 +40,7 @@ MATCH_DELAY_S = float(os.environ.get("DISPATCH_MATCH_DELAY_MS", "800")) / 1000
 @asynccontextmanager
 async def lifespan(_: FastAPI) -> Any:
     Base.metadata.create_all(engine)
+    migrate(engine)
     with SessionLocal() as s:
         seed(s)
     yield
@@ -80,6 +81,10 @@ class RideRequest(BaseModel):
     idempotency_key: str | None = Field(default=None, max_length=64)
 
 
+class DriverStatus(BaseModel):
+    online: bool
+
+
 class DriverOut(BaseModel):
     id: str
     name: str
@@ -194,6 +199,18 @@ def request_ride(body: RideRequest, s: DB) -> RideOut:
     return to_out(ride, driver)
 
 
+@app.put("/drivers/{driver_id}/status")
+def set_driver_status(driver_id: str, body: DriverStatus, s: DB) -> dict[str, Any]:
+    """Called by the driver app when a driver goes on or off shift."""
+    driver = s.get(Driver, driver_id)
+    if driver is None:
+        raise HTTPException(404, "driver not found")
+    driver.online = body.online
+    s.commit()
+    telemetry.log(log, logging.INFO, "driver status changed", driver_id=driver_id, online=body.online)
+    return {"driver_id": driver_id, "online": body.online}
+
+
 @app.get("/rides/{ride_id}")
 def get_ride(ride_id: str, s: DB) -> RideOut:
     ride = s.get(Ride, ride_id)
diff --git a/dispatch/src/dispatch/db.py b/dispatch/src/dispatch/db.py
index 068f1a3..b2690d8 100644
--- a/dispatch/src/dispatch/db.py
+++ b/dispatch/src/dispatch/db.py
@@ -6,7 +6,19 @@ import os
 import random
 from datetime import UTC, datetime
 
-from sqlalchemy import DateTime, Float, ForeignKey, Integer, String, UniqueConstraint, create_engine, select
+from sqlalchemy import (
+    Boolean,
+    DateTime,
+    Float,
+    ForeignKey,
+    Integer,
+    String,
+    UniqueConstraint,
+    create_engine,
+    inspect,
+    select,
+    text,
+)
 from sqlalchemy.engine import Engine
 from sqlalchemy.orm import DeclarativeBase, Mapped, Session, mapped_column, sessionmaker
 
@@ -27,6 +39,8 @@ class Driver(Base):
     vehicle: Mapped[str] = mapped_column(String(32))
     rating: Mapped[float] = mapped_column(Float, default=4.8)
     busy_ride_id: Mapped[str | None] = mapped_column(String(36))
+    # Drivers go offline from the driver app (breaks, end of shift); offline drivers are never matched.
+    online: Mapped[bool | None] = mapped_column(Boolean, default=True)
 
 
 class Ride(Base):
@@ -57,6 +71,14 @@ def make_engine(url: str | None = None) -> Engine:
     return create_engine(url, **kwargs)
 
 
+def migrate(engine: Engine) -> None:
+    """Bring an existing database up to the current schema (create_all only creates missing tables)."""
+    columns = {c["name"] for c in inspect(engine).get_columns("drivers")}
+    if "online" not in columns:
+        with engine.begin() as conn:
+            conn.execute(text("ALTER TABLE drivers ADD COLUMN online BOOLEAN"))
+
+
 def make_sessionmaker(engine: Engine) -> sessionmaker[Session]:
     return sessionmaker(engine, expire_on_commit=False)
 
diff --git a/dispatch/src/dispatch/matching.py b/dispatch/src/dispatch/matching.py
index 4470d70..5e4e294 100644
--- a/dispatch/src/dispatch/matching.py
+++ b/dispatch/src/dispatch/matching.py
@@ -22,7 +22,12 @@ class NoDriversAvailable(Exception):
 
 def nearest_available_driver(session: Session, city: str, pickup: Point) -> Driver:
     drivers = session.scalars(
-        select(Driver).where(Driver.city == city, Driver.busy_ride_id.is_(None), Driver.lat.is_not(None))
+        select(Driver).where(
+            Driver.city == city,
+            Driver.online.is_(True),
+            Driver.busy_ride_id.is_(None),
+            Driver.lat.is_not(None),
+        )
     ).all()
     if not drivers:
         raise NoDriversAvailable(city)
diff --git a/dispatch/tests/test_dispatch.py b/dispatch/tests/test_dispatch.py
index 563cf6b..e15c897 100644
--- a/dispatch/tests/test_dispatch.py
+++ b/dispatch/tests/test_dispatch.py
@@ -86,3 +86,12 @@ def test_idempotency_key_prevents_duplicate_rides(client: TestClient) -> None:
 
 def test_unknown_ride(client: TestClient) -> None:
     assert client.get("/rides/nope").status_code == 404
+
+
+def test_offline_drivers_are_not_matched(client: TestClient) -> None:
+    for i in range(12):
+        assert client.put(f"/drivers/sf-d{i:02d}/status", json={"online": False}).status_code == 200
+    assert client.post("/rides", json=SF_REQ).status_code == 409
+    client.put("/drivers/sf-d03/status", json={"online": True})
+    r = client.post("/rides", json=SF_REQ)
+    assert r.status_code == 201 and r.json()["driver"]["id"] == "sf-d03"
