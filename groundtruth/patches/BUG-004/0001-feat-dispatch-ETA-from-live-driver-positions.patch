@@ -6,7 +6,17 @@ import os
 import random
 from datetime import UTC, datetime
 
-from sqlalchemy import DateTime, Float, ForeignKey, Integer, String, UniqueConstraint, create_engine, select
+from sqlalchemy import (
+    DateTime,
+    Float,
+    ForeignKey,
+    Integer,
+    String,
+    UniqueConstraint,
+    create_engine,
+    select,
+    text,
+)
 from sqlalchemy.engine import Engine
 from sqlalchemy.orm import DeclarativeBase, Mapped, Session, mapped_column, sessionmaker
 
@@ -27,6 +37,7 @@ class Driver(Base):
     vehicle: Mapped[str] = mapped_column(String(32))
     rating: Mapped[float] = mapped_column(Float, default=4.8)
     busy_ride_id: Mapped[str | None] = mapped_column(String(36))
+    location_updated_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))
 
 
 class Ride(Base):
@@ -57,6 +68,18 @@ def make_engine(url: str | None = None) -> Engine:
     return create_engine(url, **kwargs)
 
 
+# Additive schema changes for existing databases (create_all only creates missing tables).
+MIGRATIONS = ["ALTER TABLE drivers ADD COLUMN IF NOT EXISTS location_updated_at TIMESTAMP WITH TIME ZONE"]
+
+
+def migrate(engine: Engine) -> None:
+    if engine.dialect.name != "postgresql":
+        return
+    with engine.begin() as conn:
+        for stmt in MIGRATIONS:
+            conn.execute(text(stmt))
+
+
 def make_sessionmaker(engine: Engine) -> sessionmaker[Session]:
     return sessionmaker(engine, expire_on_commit=False)
 
diff --git a/dispatch/src/dispatch/matching.py b/dispatch/src/dispatch/matching.py
index 4470d70..fd7495d 100644
--- a/dispatch/src/dispatch/matching.py
+++ b/dispatch/src/dispatch/matching.py
@@ -49,9 +49,6 @@ def eta_seconds(driver: Driver, ride: Ride, now: datetime | None = None) -> int:
     status = ride_status(ride, now)
     pickup = Point(ride.pickup_lat, ride.pickup_lng)
     dropoff = Point(ride.dropoff_lat, ride.dropoff_lng)
-    if driver.lat is None or driver.lng is None:
-        # Drivers without a GPS fix fall back to their city's average pickup time.
-        return 300
     if status in ("in_trip", "completed"):
         if status == "completed":
             return 0
@@ -59,7 +56,9 @@ def eta_seconds(driver: Driver, ride: Ride, now: datetime | None = None) -> int:
     now = now or datetime.now(UTC)
     assigned = ride.assigned_at or now
     assigned = assigned if assigned.tzinfo else assigned.replace(tzinfo=UTC)
-    remaining = travel_seconds(haversine_km(Point(driver.lat, driver.lng), pickup)) - int(
-        (now - assigned).total_seconds()
-    )
+    # The driver app reports live positions, so measure from where the driver actually is.
+    position = Point(driver.lat, driver.lng)  # type: ignore[arg-type]
+    if driver.location_updated_at is not None:
+        return travel_seconds(haversine_km(position, pickup))
+    remaining = travel_seconds(haversine_km(position, pickup)) - int((now - assigned).total_seconds())
     return max(0, remaining)
