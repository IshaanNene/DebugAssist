+def test_driver_location_updates_drive_eta(client: TestClient) -> None:
+    ride = client.post("/rides", json=SF_REQ).json()
+    driver_id = ride["driver"]["id"]
+    far = client.put(f"/internal/drivers/{driver_id}/location", json={"lat": 37.70, "lng": -122.47})
+    assert far.status_code == 200
+    eta_far = client.get(f"/rides/{ride['id']}/eta").json()["eta_seconds"]
+    client.put(f"/internal/drivers/{driver_id}/location", json={"lat": 37.7950, "lng": -122.3940})
+    eta_near = client.get(f"/rides/{ride['id']}/eta").json()["eta_seconds"]
+    assert eta_far > eta_near
+    assert client.put("/internal/drivers/nope/location", json={"lat": 1, "lng": 1}).status_code == 404
