From b652a75063e4cf68305092b0c9ed850e41eb039c Mon Sep 17 00:00:00 2001
From: Jonas Berg <jonas.berg@miniride.dev>
Date: Sun, 4 Oct 2026 12:57:47 +0530
Subject: [PATCH] feat(dispatch): ETA from live driver positions

Accept position reports from the driver app and compute pickup ETAs
from where the driver actually is, instead of counting down from the
position at assignment time. Drop the fixed 300 s fallback for drivers
without coordinates: every online driver now reports a position.
---
 dispatch/src/dispatch/app.py      | 21 ++++++++++++++++++++-
 dispatch/src/dispatch/db.py       | 25 ++++++++++++++++++++++++-
 dispatch/src/dispatch/matching.py | 11 +++++------
 dispatch/tests/test_dispatch.py   | 15 +++++++++++++--
 4 files changed, 62 insertions(+), 10 deletions(-)

diff --git a/dispatch/src/dispatch/app.py b/dispatch/src/dispatch/app.py
index b9791db..2685abd 100644
--- a/dispatch/src/dispatch/app.py
+++ b/dispatch/src/dispatch/app.py
@@ -19,7 +19,7 @@ from sqlalchemy.exc import IntegrityError
 from sqlalchemy.orm import Session
 
 from dispatch import telemetry, vitals_sdk
-from dispatch.db import Base, Driver, Ride, make_engine, make_sessionmaker, seed
+from dispatch.db import Base, Driver, Ride, make_engine, make_sessionmaker, migrate, seed
 from dispatch.flags import Flags
 from dispatch.geo import PLACES, Point, haversine_km
 from dispatch.matching import NoDriversAvailable, eta_seconds, nearest_available_driver, ride_status
@@ -40,6 +40,7 @@ MATCH_DELAY_S = float(os.environ.get("DISPATCH_MATCH_DELAY_MS", "800")) / 1000
 @asynccontextmanager
 async def lifespan(_: FastAPI) -> Any:
     Base.metadata.create_all(engine)
+    migrate(engine)
     with SessionLocal() as s:
         seed(s)
     yield
@@ -194,6 +195,24 @@ def request_ride(body: RideRequest, s: DB) -> RideOut:
     return to_out(ride, driver)
 
 
+class LocationUpdate(BaseModel):
+    lat: float | None = None  # null when the driver app has no GPS fix
+    lng: float | None = None
+    accuracy_m: float | None = None
+
+
+@app.put("/internal/drivers/{driver_id}/location")
+def update_driver_location(driver_id: str, body: LocationUpdate, s: DB) -> dict[str, Any]:
+    """Position reports from the driver app (every few seconds while online)."""
+    driver = s.get(Driver, driver_id)
+    if driver is None:
+        raise HTTPException(404, "driver not found")
+    driver.lat, driver.lng = body.lat, body.lng
+    driver.location_updated_at = datetime.now(UTC)
+    s.commit()
+    return {"driver_id": driver_id, "lat": driver.lat, "lng": driver.lng}
+
+
 @app.get("/rides/{ride_id}")
 def get_ride(ride_id: str, s: DB) -> RideOut:
     ride = s.get(Ride, ride_id)
diff --git a/dispatch/src/dispatch/db.py b/dispatch/src/dispatch/db.py
